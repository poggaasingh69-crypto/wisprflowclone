<Window x:Class="FlowNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowNote"
        Width="220"
        Height="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border Padding="20,12"
            Background="#FF202124"
            CornerRadius="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="FlowNote" />
            <TextBlock Foreground="#FFB8BCC2"
                       FontSize="11"
                       Text="Ready" />
        </StackPanel>
    </Border>
</Window>
